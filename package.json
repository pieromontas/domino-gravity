{
  "name": "domino-gravity",
  "version": "1.0.0",
  "private": true,
  "description": "Domino Gravity - 3D Multiplayer Dominoes Discord Activity",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=client",
    "dev:all": "npm run dev --workspaces --parallel",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspace=client && npm run test --workspace=server",
    "start": "node server/dist/server.js"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "discord-activity",
    "threejs",
    "dominoes",
    "multiplayer",
    "embedded-app-sdk"
  ],
  "author": "",
  "license": "MIT"
}
