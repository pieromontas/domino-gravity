# Public Discord Application ID (not a secret). Vite embeds this at build time.
# Azure App Settings do not rewrite the client bundle — they only feed the Node
# server at runtime. Keep DISCORD_CLIENT_SECRET out of this file.
# Optional override: set VITE_DISCORD_CLIENT_ID in the environment (e.g. GitHub
# Actions secret) before `vite build`.
VITE_DISCORD_CLIENT_ID=1551749381705961514
