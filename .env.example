# Discord Developer Portal credentials
# From https://discord.com/developers/applications
# VITE_DISCORD_CLIENT_ID is required at Vite *build* time and again at server runtime.
# Azure App Settings do not bake this into the client bundle — only CI / vite build does.
# Production builds default to the public Application ID in client/.env.production.
VITE_DISCORD_CLIENT_ID=your_client_id_here

# Server-only. Never expose this to the client bundle or Vite env.
DISCORD_CLIENT_SECRET=your_client_secret_here

# Server configuration
# Azure App Service injects PORT. Do not hardcode it in production.
PORT=3001
NODE_ENV=development

# Optional: reconnect / empty-room cleanup window in milliseconds (default 60000)
ROOM_GRACE_MS=60000

# Optional: server AI think delay in milliseconds (default 800)
AI_DELAY_MS=800

# Optional: allow POST /api/dev-session in production (default off when NODE_ENV=production)
# ALLOW_DEV_SESSIONS=1
